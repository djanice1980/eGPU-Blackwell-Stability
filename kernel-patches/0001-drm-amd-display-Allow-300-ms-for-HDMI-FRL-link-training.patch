From 0927eea9f98a221e9fa5908e43f6a75778824ab9 Mon Sep 17 00:00:00 2001
From: David Janice <djanice1980@gmail.com>
Date: Tue, 22 Sep 2026 08:42:24 -0500
Subject: [PATCH 1/3] drm/amd/display: Allow ~300 ms for HDMI FRL link training

---
 .../amd/display/dc/link/protocols/link_hdmi_frl.c    | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c b/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
index c350741..85e88b5 100644
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
@@ -511,8 +511,18 @@ static enum link_result hdmi_frl_perform_link_training(struct ddc_service *ddc_s
 
 		FRL_INFO("FRL LINK TRAINING:  Poll for FLT_UPDATE.\n");
 		/*LTS:3: Start Link Training*/
-		/*Start FLT Timer = 200 ms*/
+		/*
+		 * Start FLT Timer. HDMI 2.1 specifies FLT_TIMEOUT = 200 ms, but the
+		 * budget here runs from the FRL_Rate write to the final FLT_update
+		 * and some sinks need more than that in total: an LG C2 (2022) at
+		 * 10G x4 raises its first FLT_update (the LTP request) ~45 ms after
+		 * the rate write and reports lock a further ~180 ms later, ~225 ms in
+		 * all, so it failed the 105-poll (~210 ms) budget on most DPMS wakes
+		 * at 4K120 while at 6G x4 (~20 ms + ~180 ms) it just fit. Allow
+		 * ~300 ms for every rate.
+		 */
 		num_polls = 0;
+		max_polls = 155;
 		if (flt_no_timeout)
 			max_polls = 500;
 
