From 2f0baf15c128a67d8c7b8fa23dd3aa288ebb0939 Mon Sep 17 00:00:00 2001
From: David Janice <djanice1980@gmail.com>
Date: Tue, 22 Sep 2026 08:42:24 -0500
Subject: [PATCH 3/3] drm/amd/display: local HDMI FRL watchdog diagnostics and
 link re-enable on loss of lock

Local debugging patch for an intermittent dark HDMI output on DCN 3.5 (Strix
Halo, native HDMI FRL, LG C2). Not upstream-shaped: the state is in file statics,
adequate for one FRL link.

1. Log the sink SCDC state once per 200 ms poll (drm_dbg, silent unless
   drm.debug=0x2): the DDC result of each read, the Update_0 byte, and the status
   flags with per-lane lock bits. Upstream ignores the DDC return value, so a sink
   that has stopped answering reads back as all-zero flags and looks happy.

2. Re-enable the link when the sink reports every lane unlocked while an FRL rate
   is active. Upstream reacts only to FLT_update, which the sink raises during
   training, so a link that trains, is acknowledged with FRL_START and then loses
   lock is never noticed. Measured on a dark screen: 1443 consecutive polls over
   five minutes, all status=0x40 (FLT_READY, no lane locked) with Update_0=0x43
   (STATUS_UPDATE set, FLT_UPDATE clear), while the source held 10G x4 and scanned
   out 10 bpc BT2020.

   The recovery is dc_link_dp_handle_link_loss(), the same pipe dpms off/on the DP
   HPD path uses, not dc_link_detect(DETECT_REASON_RETRAIN): with the sink
   unchanged, detect re-reads the EDID and leaves the link alone. Twelve
   detect-based attempts over 56 s produced no modeset and no lock.

   Debounced by three polls (~600 ms) so a modeset transient does not trigger it,
   one attempt per 5 s, and capped at twelve attempts so an unrecoverable sink
   cannot drive an endless modeset loop.

3. Record lock-state transitions, each re-enable request, the give-up and the
   recovery at warning level, and promote the "200ms frl status polling
   starts/stops" messages to drm_info, so an ordinary journal tells the whole
   story: journalctl -k | grep "HDMI FRL"
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |  18 ++-
 .../display/dc/link/protocols/link_hdmi_frl.c | 113 +++++++++++++++++-
 2 files changed, 127 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 27a466a..490b3c1 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -2030,7 +2030,19 @@ static void hdmi_frl_status_polling_work(struct work_struct *work)
 		link_update = dc_link_frl_poll_status_flag(dc_link);
 		if (link_update) {
 			mutex_lock(&dm->dc_lock);
-			dc_link_detect(dc_link, DETECT_REASON_RETRAIN);
+			/*
+			 * Full link re-enable, the path the DP HPD handler uses for link
+			 * loss: it disables and re-enables every master pipe on the link,
+			 * which re-runs FRL link training. dc_link_detect() with
+			 * DETECT_REASON_RETRAIN does not -- with the sink unchanged it
+			 * re-reads the EDID and leaves the link alone. Measured 2026-09-22
+			 * 08:36: twelve detect-based requests over 56 s produced no modeset
+			 * and no lock; the picture returned only when the sink latched on by
+			 * itself. Despite its name the function is generic (link_set_dpms_off
+			 * then _on over the link's pipes); its only DP-specific block is
+			 * guarded by skip_fallback_on_link_loss, which is false here.
+			 */
+			dc_link_dp_handle_link_loss(dc_link);
 			mutex_unlock(&dm->dc_lock);
 		}
 	}
@@ -11294,10 +11306,10 @@ static void amdgpu_dm_commit_streams(struct drm_atomic_commit *state,
 		if (queue_delayed_work(dm->hdmi_frl_status_polling_wq,
 				       &dm->hdmi_frl_status_polling_work,
 				       msecs_to_jiffies(dm->hdmi_frl_status_polling_delay_ms)))
-			drm_dbg_kms(dev, "200ms frl status polling starts ...\n");
+			drm_info(dev, "200ms frl status polling starts ...\n");
 	} else {
 		if (cancel_delayed_work_sync(&dm->hdmi_frl_status_polling_work))
-			drm_dbg_kms(dev, "200ms frl status polling stops ...\n");
+			drm_info(dev, "200ms frl status polling stops ...\n");
 	}
 	/* Allow idle optimization when vblank count is 0 for display off */
 	if ((dm->active_vblank_irq_count == 0) && amdgpu_dm_is_headless(dm->adev))
diff --git a/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c b/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
index 85e88b5..1f4d8bc 100644
--- a/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
+++ b/drivers/gpu/drm/amd/display/dc/link/protocols/link_hdmi_frl.c
@@ -194,6 +194,15 @@ void hdmi_frl_LTS_clear_Update_flag(struct ddc_service *ddc_service)
 }
 
 
+/* watchdog state; see the comment in hdmi_frl_poll_status_flag(). Single FRL link assumed. */
+#define FRL_UNLOCK_DEBOUNCE_POLLS 3     /* ~600 ms: ride out the transient at a modeset */
+#define FRL_REENABLE_INTERVAL_NS  5000000000ULL
+#define FRL_REENABLE_MAX_ATTEMPTS 12    /* ~1 min, then stop and wait for a state change */
+static unsigned long long frl_last_reenable_ts;
+static int frl_last_lock_state = -1;
+static unsigned int frl_unlocked_polls;
+static unsigned int frl_reenable_attempts;
+
 bool hdmi_frl_poll_status_flag(struct dc_link *link)
 {
 	uint8_t slave_address = HDMI_SCDC_ADDRESS;
@@ -210,6 +219,11 @@ bool hdmi_frl_poll_status_flag(struct dc_link *link)
 	struct link_encoder *dio_link_enc = link->link_enc;
 	bool flt_no_timeout = false;
 	bool link_update = false;
+	bool update0_ddc_ok, status_ddc_ok;
+	union hdmi_scdc_status_flags_data scdc_status = {0};
+	uint8_t status_offset = HDMI_SCDC_STATUS_FLAGS;
+
+	DC_LOGGER_INIT(link->ctx->logger);
 
 	/*Test Condition - FLT_no_timeout avoid link training*/
 	offset = HDMI_SCDC_SOURCE_TEST_REQ;
@@ -221,10 +235,107 @@ bool hdmi_frl_poll_status_flag(struct dc_link *link)
 	offset = HDMI_SCDC_UPDATE_0;
 
 	/*Check FLT_update flag*/
-	link_query_ddc_data(link->ddc, slave_address,
+	update0_ddc_ok = link_query_ddc_data(link->ddc, slave_address,
 					&offset, sizeof(offset), &scdc_update.byte[0],
 					sizeof(scdc_update.byte[0]));
 
+	/*
+	 * Local diagnostic. This watchdog runs every 200 ms on an FRL link and
+	 * acts only when the sink raises FLT_UPDATE; it ignores whether the DDC
+	 * read worked at all, so a sink that has stopped answering reads back as
+	 * all-zero flags and is indistinguishable from a happy one. Also read the
+	 * SCDC status flags (0x40), which carry the sink's own lane-lock state,
+	 * and log both. drm_dbg, so silent unless drm.debug=0x2 is set; the extra
+	 * one-byte DDC read costs a few hundred microseconds per poll.
+	 */
+	status_ddc_ok = link_query_ddc_data(link->ddc, slave_address,
+					&status_offset, sizeof(status_offset), &scdc_status.byte,
+					sizeof(scdc_status.byte));
+	FRL_INFO("FRL WATCHDOG: rate=%d update0[ddc=%d]=0x%02x (FRL_START=%d FLT_UPDATE=%d)"
+			" status[ddc=%d]=0x%02x (clk=%d ln0=%d ln1=%d ln2=%d ln3=%d flt_ready=%d dsc_fail=%d)\n",
+			link->frl_link_settings.frl_link_rate,
+			update0_ddc_ok, scdc_update.byte[0],
+			scdc_update.fields.FRL_START, scdc_update.fields.FLT_UPDATE,
+			status_ddc_ok, scdc_status.byte,
+			scdc_status.fields.CLOCK_DETECTED, scdc_status.fields.CH0_LOCKED,
+			scdc_status.fields.CH1_LOCKED, scdc_status.fields.CH2_LOCKED,
+			scdc_status.fields.LANE3_LOCKED, scdc_status.fields.FLT_READY,
+			scdc_status.fields.DSC_DECODEFAIL);
+
+	/*
+	 * Log every change of the sink's lock state, once, at a level an ordinary
+	 * journal keeps. Masked to the bits that matter -- CLOCK_DETECTED and the four
+	 * lane locks, plus FRL_START/FLT_UPDATE -- because the sink also toggles its
+	 * character- and RS-error update bits constantly on a healthy link, which would
+	 * make this chatty. Silent while the state is steady, one line per transition.
+	 */
+	if (status_ddc_ok && update0_ddc_ok) {
+		int lock_state = (scdc_status.byte & 0x1f) | ((scdc_update.byte[0] & 0x30) << 8);
+
+		if (lock_state != frl_last_lock_state) {
+			DC_LOG_WARNING("HDMI FRL: sink state changed -- status=0x%02x"
+					" (clk=%d lanes=%d%d%d%d flt_ready=%d) update0=0x%02x rate=%d\n",
+					scdc_status.byte,
+					scdc_status.fields.CLOCK_DETECTED, scdc_status.fields.CH0_LOCKED,
+					scdc_status.fields.CH1_LOCKED, scdc_status.fields.CH2_LOCKED,
+					scdc_status.fields.LANE3_LOCKED, scdc_status.fields.FLT_READY,
+					scdc_update.byte[0], link->frl_link_settings.frl_link_rate);
+			frl_last_lock_state = lock_state;
+		}
+	}
+
+	/*
+	 * Re-enable the link when the sink says it has lost lock.
+	 *
+	 * The sink reports per-lane lock in the SCDC status flags and announces a
+	 * change through Status_Update (Update_0 bit 0). Upstream only reacts to
+	 * FLT_update, which the sink raises during link training -- so a link that
+	 * trains, is acknowledged with FRL_START and then loses lock is never noticed.
+	 *
+	 * Note CLOCK_DETECTED is a TMDS-era bit and reads 0 on a healthy FRL link: the
+	 * healthy state here is status=0x5e (four lanes locked, FLT_READY), and the
+	 * dark state is 0x40 (FLT_READY alone). The lane bits are the signal.
+	 *
+	 * Debounced by FRL_UNLOCK_DEBOUNCE_POLLS because a modeset briefly leaves the
+	 * sink unlocked, and capped at FRL_REENABLE_MAX_ATTEMPTS so a sink that will
+	 * not come back cannot drive an endless modeset loop.
+	 */
+	if (status_ddc_ok && link->frl_link_settings.frl_link_rate != 0 &&
+			scdc_status.fields.CH0_LOCKED == 0 &&
+			scdc_status.fields.CH1_LOCKED == 0 &&
+			scdc_status.fields.CH2_LOCKED == 0 &&
+			scdc_status.fields.LANE3_LOCKED == 0) {
+		unsigned long long now = dm_get_timestamp(link->ctx);
+
+		frl_unlocked_polls++;
+		if (frl_unlocked_polls >= FRL_UNLOCK_DEBOUNCE_POLLS &&
+				frl_reenable_attempts < FRL_REENABLE_MAX_ATTEMPTS &&
+				(frl_last_reenable_ts == 0 ||
+				 dm_get_elapse_time_in_ns(link->ctx, now, frl_last_reenable_ts)
+					> FRL_REENABLE_INTERVAL_NS)) {
+			frl_last_reenable_ts = now;
+			frl_reenable_attempts++;
+			DC_LOG_WARNING("HDMI FRL: sink reports loss of lock (status=0x%02x)"
+					" with rate=%d active -- re-enabling the link (attempt %u)\n",
+					scdc_status.byte, link->frl_link_settings.frl_link_rate,
+					frl_reenable_attempts);
+			link_update = true;
+		} else if (frl_reenable_attempts == FRL_REENABLE_MAX_ATTEMPTS) {
+			frl_reenable_attempts++;	/* log the give-up once */
+			DC_LOG_WARNING("HDMI FRL: sink still unlocked after %u re-enable"
+					" attempts -- giving up until its state changes\n",
+					FRL_REENABLE_MAX_ATTEMPTS);
+		}
+	} else if (scdc_status.fields.CH0_LOCKED) {
+		if (frl_reenable_attempts)
+			DC_LOG_WARNING("HDMI FRL: sink lock restored (status=0x%02x) after"
+					" %u re-enable request(s)\n",
+					scdc_status.byte, frl_reenable_attempts);
+		frl_last_reenable_ts = 0;
+		frl_unlocked_polls = 0;
+		frl_reenable_attempts = 0;
+	}
+
 	if (scdc_update.fields.FRL_START == 1) {
 		write_buffer[0] = HDMI_SCDC_UPDATE_0;
 		/*FLT_START - bit 4*/
-- 
2.55.0

