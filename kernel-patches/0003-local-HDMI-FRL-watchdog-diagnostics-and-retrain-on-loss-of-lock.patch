+#define FRL_REENABLE_FAST_ATTEMPTS 12              /* covers the ~25 s the sink needs after deep standby */
+#define FRL_REENABLE_SLOW_NS       60000000000ULL  /* then once a minute, for as long as it lasts */
+#define FRL_WATCH_GAP_NS           2000000000ULL   /* polls are 200 ms apart; a longer gap = new session */
