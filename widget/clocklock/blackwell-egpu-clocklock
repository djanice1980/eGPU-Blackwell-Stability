#!/usr/bin/env bash
# Privileged helper for the Blackwell eGPU Status widget's clock-lock toggle.
# Deliberately narrow: lock/unlock GPU clocks and manage the boot-pin flag.
# Installed root-owned in /usr/local/bin; the sudoers entry allows ONLY the
# literal argument forms handled below (see install-clocklock.sh).
set -euo pipefail
export PATH=/usr/bin:/usr/sbin:/bin:/sbin

RUN_DIR=/run/blackwell-egpu
PIN_FLAG=/etc/blackwell-egpu/clocklock-pinned
GPU_MIN=2000   # MHz floor for the graphics clock lock; memory locks at its max

apply() {
    local max_gr max_mem
    max_gr=$(nvidia-smi --query-gpu=clocks.max.graphics --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -dc '0-9')
    max_mem=$(nvidia-smi --query-gpu=clocks.max.memory --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -dc '0-9')
    if [ -z "$max_gr" ] || [ -z "$max_mem" ]; then
        echo "blackwell-egpu-clocklock: no NVIDIA GPU reachable" >&2
        return 1
    fi
    nvidia-smi --lock-gpu-clocks="$GPU_MIN,$max_gr" >/dev/null
    nvidia-smi --lock-memory-clocks="$max_mem,$max_mem" >/dev/null
    mkdir -p "$RUN_DIR"
    : > "$RUN_DIR/locked"
}

release() {
    nvidia-smi --reset-gpu-clocks >/dev/null 2>&1 || true
    nvidia-smi --reset-memory-clocks >/dev/null 2>&1 || true
    rm -f "$RUN_DIR/locked"
}

case "${1:-}" in
    on)
        apply
        ;;
    off)
        release
        ;;
    pin)
        mkdir -p "$(dirname "$PIN_FLAG")"
        : > "$PIN_FLAG"
        apply || true   # pin sticks even if the card is not attached right now
        ;;
    unpin)
        rm -f "$PIN_FLAG"
        ;;
    boot-apply)
        # Invoked by egpu-clocklock.service (boot and nvidia driver-bind).
        # Not in the sudoers whitelist; systemd runs it as root directly.
        [ -f "$PIN_FLAG" ] || exit 0
        for _ in $(seq 30); do
            if nvidia-smi -L >/dev/null 2>&1; then
                apply
                exit 0
            fi
            sleep 2
        done
        exit 0   # card never showed up; udev bind will retrigger on attach
        ;;
    *)
        echo "usage: blackwell-egpu-clocklock on|off|pin|unpin|boot-apply" >&2
        exit 2
        ;;
esac
