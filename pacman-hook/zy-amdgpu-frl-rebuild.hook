[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux-cachyos
Target = linux-cachyos-headers

# NetworkAccess: pacman 7.1 runs hooks in a fresh network namespace with only loopback unless the
# hook allows the network (alpm-hooks(5)). Without it the git pull / source download this hook
# needs fails in ~1 ms ("Failed to connect to github.com:443 ... Could not connect to server") --
# what left 7.2.10-1 (2026-10-15) and 7.3.0-4 (2026-10-22) on the stock module.
[Action]
Description = Building the patched amdgpu (HDMI FRL recovery) for the new kernel (several minutes)...
When = PostTransaction
Exec = /usr/local/bin/amdgpu-frl-rebuild
NetworkAccess = allowed
