#!/usr/bin/env bash
# WORKAROUND (not a fix): amdgpu's HDMI FRL link training retries only 3x200 ms inside
# enable_link_hdmi_frl(), then link_set_dpms_on_enable_link() returns DC_DPMS_SUCCESS anyway
# ("some DP monitors will recover and show the stream") and the SCDC polling worker is only
# armed on success. So a monitor still in standby at the first enable after DPMS/lock-screen
# wake stays dark until the next modeset. No driver knob exists (amdgpu_dm_debugfs.c has no
# FRL entries). This follows the kernel journal for that failure and requests a fresh modeset
# via display-rescue (KScreen over DBus, works while locked).
#
# Timing from the 2026-09-07 23:15 episode: failure at T+0, the monitor's own HPD pulse at
# T+8 s. So wait DELAY s before the first retry, and allow up to ROUNDS retries per episode
# (each retry that fails logs the same line again and re-arms us after COOLDOWN).
set -u
DELAY=8        # s to wait after the failure line before forcing a modeset
COOLDOWN=15    # s between retries (display-rescue itself takes ~2 s)
ROUNDS=3       # max retries per episode
EPISODE=180    # s; failures further apart than this start a new episode
last=0; rounds=0
journalctl -k -f -o cat -n 0 2>/dev/null \
  | grep --line-buffered -E "enabling link [0-9]+ failed" \
  | while read -r line; do
        now=$(date +%s)
        if [ $(( now - last )) -gt "$EPISODE" ]; then rounds=0; fi
        if [ $(( now - last )) -lt "$COOLDOWN" ]; then continue; fi
        if [ "$rounds" -ge "$ROUNDS" ]; then
            logger -t hdmi-link-retry "giving up after $ROUNDS retries: $line"; continue
        fi
        last=$now; rounds=$(( rounds + 1 ))
        sleep "$DELAY"
        if "$HOME/.local/bin/display-rescue"; then
            logger -t hdmi-link-retry "retry $rounds/$ROUNDS: forced modeset ${DELAY}s after: $line"
        else
            logger -t hdmi-link-retry "retry $rounds/$ROUNDS: display-rescue failed after: $line"
        fi
    done
