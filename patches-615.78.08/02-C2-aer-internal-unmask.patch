From 6ce3502131799ecf37abc542d2b315e1ed44a72e Mon Sep 17 00:00:00 2001
From: egpu <egpu@local>
Date: Thu, 10 Sep 2026 16:38:38 -0500
Subject: [PATCH 2/6] port: 02-C2-aer-internal-unmask (3-way, conflict
 resolved: keep NVIDIA deferred-probe typedef + helper)

---
 kernel-open/nvidia/nv-pci.c | 49 +++++++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/kernel-open/nvidia/nv-pci.c b/kernel-open/nvidia/nv-pci.c
index 48d8b788..79bc0898 100644
--- a/kernel-open/nvidia/nv-pci.c
+++ b/kernel-open/nvidia/nv-pci.c
@@ -2143,6 +2143,48 @@ typedef struct
 /* Used to differentiate probe behavior during driver registration vs later rebinds */
 static NvBool nv_pci_driver_registration_in_progress = NV_FALSE;
 
+/*
+ * Unmask the AER "Internal Error" bits on a device.
+ *
+ * Some platforms leave the AER Uncorrectable Internal Error bit
+ * (PCI_ERR_UNC_INTN) masked.  Per PCIe r6.0 sec 6.2.3.2 a masked
+ * uncorrectable error is demoted to Advisory Non-Fatal: its status is not
+ * latched, the Header Log is not captured, and the driver's
+ * pci_error_handlers are never invoked -- the error becomes invisible to
+ * the kernel's AER recovery path.  Clear the Internal Error bits so these
+ * errors take the normal recovery path.
+ *
+ * This is the same operation the kernel performs in
+ * pci_aer_unmask_internal_errors() (drivers/pci/pcie/aer.c), which is only
+ * exported to the CXL core; hand-rolled here so the GPU driver can make the
+ * same device-specific decision for its devices.
+ */
+static void
+nv_pci_unmask_aer_internal_errors(struct pci_dev *pci_dev)
+{
+    int aer = pci_find_ext_capability(pci_dev, PCI_EXT_CAP_ID_ERR);
+    u32 mask;
+
+    if (aer == 0)
+        return;
+
+    if (pci_read_config_dword(pci_dev, aer + PCI_ERR_UNCOR_MASK, &mask) == 0 &&
+        (mask & PCI_ERR_UNC_INTN) != 0)
+    {
+        pci_write_config_dword(pci_dev, aer + PCI_ERR_UNCOR_MASK,
+                               mask & ~PCI_ERR_UNC_INTN);
+        pci_info(pci_dev,
+                 "AER: unmasked Uncorrectable Internal Error at probe\n");
+    }
+
+    if (pci_read_config_dword(pci_dev, aer + PCI_ERR_COR_MASK, &mask) == 0 &&
+        (mask & PCI_ERR_COR_INTERNAL) != 0)
+    {
+        pci_write_config_dword(pci_dev, aer + PCI_ERR_COR_MASK,
+                               mask & ~PCI_ERR_COR_INTERNAL);
+    }
+}
+
 /* find nvidia devices and set initial state */
 static int
 nv_pci_probe_body
@@ -2193,6 +2235,13 @@ nv_pci_probe_body
     }
 #endif /* NV_PCI_SRIOV_SUPPORT */
 
+    /*
+     * Unmask AER Internal Errors before init so a transient PCIe error
+     * during bring-up reaches the standard recovery path instead of being
+     * silently demoted.  SR-IOV VFs returned above; this runs for the PF.
+     */
+    nv_pci_unmask_aer_internal_errors(pci_dev);
+
     if (nv_kmem_cache_alloc_stack(&sp) != 0)
     {
         return -1;
-- 
